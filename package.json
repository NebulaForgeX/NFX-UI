{
  "name": "nfx-ui",
  "version": "0.20.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/themes/fonts.ts",
    "**/themes/fonts.js"
  ],
  "description": "Unified frontend UI library for the NFX product family: shared React components, design tokens, theme variables, and layout primitives for a consistent look and behavior across NFX console and other apps.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NebulaForgeX/NFX-UI"
  },
  "homepage": "https://github.com/NebulaForgeX/NFX-UI#readme",
  "bugs": {
    "url": "https://github.com/NebulaForgeX/NFX-UI/issues"
  },
  "exports": {
    "./enums": {
      "types": "./dist/src/enums/index.d.ts",
      "import": "./dist/enums.mjs",
      "require": "./dist/enums.cjs",
      "default": "./dist/enums.mjs"
    },
    "./themes": {
      "types": "./dist/src/themes/index.d.ts",
      "import": "./dist/themes.mjs",
      "require": "./dist/themes.cjs",
      "default": "./dist/themes.mjs"
    },
    "./layouts": {
      "types": "./dist/src/designs/layouts/index.d.ts",
      "import": "./dist/layouts.mjs",
      "require": "./dist/layouts.cjs",
      "default": "./dist/layouts.mjs"
    },
    "./components": {
      "types": "./dist/src/designs/components/index.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.cjs",
      "default": "./dist/components.mjs"
    },
    "./animations": {
      "types": "./dist/src/designs/animations/index.d.ts",
      "import": "./dist/animations.mjs",
      "require": "./dist/animations.cjs",
      "default": "./dist/animations.mjs"
    },
    "./hooks": {
      "types": "./dist/src/hooks/index.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.cjs",
      "default": "./dist/hooks.mjs"
    },
    "./stores": {
      "types": "./dist/src/stores/index.d.ts",
      "import": "./dist/stores.mjs",
      "require": "./dist/stores.cjs",
      "default": "./dist/stores.mjs"
    },
    "./apis": {
      "types": "./dist/src/apis/index.d.ts",
      "import": "./dist/apis.mjs",
      "require": "./dist/apis.cjs",
      "default": "./dist/apis.mjs"
    },
    "./events": {
      "types": "./dist/src/events/index.d.ts",
      "import": "./dist/events.mjs",
      "require": "./dist/events.cjs",
      "default": "./dist/events.mjs"
    },
    "./services": {
      "types": "./dist/src/services/index.d.ts",
      "import": "./dist/services.mjs",
      "require": "./dist/services.cjs",
      "default": "./dist/services.mjs"
    },
    "./navigations": {
      "types": "./dist/src/navigations/index.d.ts",
      "import": "./dist/navigations.mjs",
      "require": "./dist/navigations.cjs",
      "default": "./dist/navigations.mjs"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs",
      "default": "./dist/types.mjs"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs",
      "default": "./dist/utils.mjs"
    },
    "./constants": {
      "types": "./dist/src/constants/index.d.ts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.cjs",
      "default": "./dist/constants.mjs"
    },
    "./languages": {
      "types": "./dist/src/languages/index.d.ts",
      "import": "./dist/languages.mjs",
      "require": "./dist/languages.cjs",
      "default": "./dist/languages.mjs"
    },
    "./icons": {
      "types": "./dist/src/icons/index.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.cjs",
      "default": "./dist/icons.mjs"
    },
    "./themes/fonts": "./src/themes/fonts.ts",
    "./themes/styles.css": "./src/themes/index.css",
    "./pixel-blast": {
      "types": "./dist/src/designs/animations/PixelBlast/index.d.ts",
      "import": "./dist/pixel-blast.mjs",
      "require": "./dist/pixel-blast.cjs",
      "default": "./dist/pixel-blast.mjs"
    },
    "./providers": {
      "types": "./dist/src/providers/index.d.ts",
      "import": "./dist/providers.mjs",
      "require": "./dist/providers.cjs",
      "default": "./dist/providers.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && vite build && tsc -p tsconfig.dts.json",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:code-format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,cjs,mjs,json,md}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,cjs,mjs,json,md}\"",
    "check:update": "npx npm-check-updates"
  },
  "peerDependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "axios-case-converter": "^2.0.1",
    "clsx": "^2.1.1",
    "eventemitter3": "^5.0.4",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.1.1",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-pro-sidebar": "^1.1.0",
    "react-router": "^8.3.1",
    "react-virtuoso": "^4.18.12",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "eventemitter3": {
      "optional": true
    },
    "postprocessing": {
      "optional": true
    },
    "axios-case-converter": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "react-virtuoso": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "nfx",
    "NebulaForgeX",
    "NFX-UI",
    "design-system"
  ],
  "license": "MIT",
  "author": "NebulaForgeX",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.11",
    "async-retry": "^1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/async-retry": "^1.4.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "axios-case-converter": "^2.0.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eventemitter3": "^5.0.4",
    "globals": "^17.12.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.1.1",
    "postprocessing": "^6.39.5",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-pro-sidebar": "^1.1.0",
    "react-router": "^8.3.1",
    "react-virtuoso": "^4.18.12",
    "three": "^0.186.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "@ibm/plex-sans-sc": false
  }
}